# Public: safe to expose. Supabase RLS protects organization data.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AGORA_APP_ID=

# Server only. Use a Supabase secret key (or legacy service_role key).
SUPABASE_SECRET_KEY=
# Must be a public HTTPS origin for Agora custom tool callbacks; no trailing path.
APP_URL=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
MURF_API_KEY=
MURF_VOICE_ID=
MURF_LOCALE=en-US
GEMINI_API_KEY=
# Text model, not Gemini Live. Confirm availability for your Google account.
GEMINI_MODEL=gemini-3.6-flash
# Generate independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGORA_TOOL_SECRET=
CRON_SECRET=

# Seed-only. A fixed planning clock makes the labelled sample reproducible.
DEMO_REFERENCE_DATE=2026-11-23
DEMO_MERCH_EMAIL=merch@nool.example
DEMO_LEAD_EMAIL=production@nool.example

# Optional real Supabase browser verification. Uses the generated seed credentials.
E2E_BASE_URL=http://localhost:3000
E2E_MERCH_EMAIL=
E2E_MERCH_PASSWORD=
E2E_LEAD_EMAIL=
E2E_LEAD_PASSWORD=
# Explicitly permits the browser test to approve changes in the sample company.
E2E_RUN_WORKFLOW=0
